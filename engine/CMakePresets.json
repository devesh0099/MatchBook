{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "dev — asserts on, sanitizers on",
      "description": "For building the engine, generator and harness. Never used for ranked runs.",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "contest",
      "displayName": "contest — the published flags",
      "description": "Exactly what the correctness pool and the benchmark node compile with.",
      "binaryDir": "${sourceDir}/build/contest",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": ""
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "contest", "configurePreset": "contest" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "contest", "configurePreset": "contest", "output": { "outputOnFailure": true } }
  ]
}
