# Optional. ops/aws/bootstrap.sh reads these three values out of
# ../terraform.tfvars and passes them in, so this file only matters if you run
# `terraform -chdir=infra/bootstrap apply` by hand.
#
# If you do run it by hand, THESE MUST MATCH ../terraform.tfvars. Terraform does
# not check, and each mismatch fails somewhere that does not mention it:
#
#   aws_region   the bucket is created here, and the deployer policy's
#                aws:RequestedRegion condition is templated from this value.
#                Bootstrap in us-east-1 while ../ deploys to ap-south-1 and the
#                first call under that role is UnauthorizedOperation — and every
#                submission crosses regions to reach S3.
#   name_prefix  the policy conditions destructive actions on
#                Project = <name_prefix>. A mismatch is AccessDenied on teardown.

aws_region  = "ap-south-1"
name_prefix = "flashmatch"

# Null means the ordinary AWS credential chain (env vars, AWS_PROFILE, the
# default profile, SSO). Set it only if you need a specific named profile.
# aws_profile = "default"

# Bucket name defaults to <name_prefix>-artifacts-<account-id>, because bucket
# names are globally unique and a fixed one collides the moment two people try.
# bucket_name = "flashmatch-artifacts-123456789012"

# Keep previous versions of artifacts. The node role holds s3:PutObject on the
# whole bucket and the workers run participant code, so this is the only undo
# for an overwritten submission.
bucket_versioning = true

# True is right for a throwaway test and WRONG for the real event: the bucket
# holds every submission's source.
force_destroy_bucket = true

# Who may assume the deployer role. Defaults to whoever runs bootstrap, resolved
# to a durable role or user ARN rather than the STS session ARN.
# deployer_trusted_principal = "arn:aws:iam::123456789012:user/someone"
